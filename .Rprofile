# Pin Hugo to the version this Wowchemy v5 site was written for.
# Matches HUGO_VERSION in netlify.toml. Without this, blogdown picks the
# newest Hugo on the system (0.150 today) which is incompatible with
# Wowchemy v5 in many places (paginate, site.GoogleAnalytics, .File.UniqueID,
# /authors/authors, ...).
options(blogdown.hugo.version = "0.91.2")
